PORT=3001
MONGODB_URI=mongodb://localhost:27017/shift-tracker
# Required, at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
NODE_ENV=development
# Comma-separated emails that may use /register and are always admins
ADMIN_EMAILS=you@example.com

# Optional: shift start/end emails via Gmail (leave blank to disable)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Optional: set to true to block clock-in/out when GPS is unavailable
REQUIRE_LOCATION=false
# Optional: comma-separated origins allowed to call the API from another domain
# (not needed when the backend serves the frontend in production)
CORS_ORIGIN=
# Optional: set to 1 when running behind a reverse proxy (nginx, Render, Railway...)
TRUST_PROXY=
# Optional: limits for admin shift corrections
MAX_SHIFT_HOURS=24
MAX_EDIT_AGE_DAYS=90
# Optional: timezone used for times in notification emails (uncomment to set)
# TZ=America/New_York

# Cloudflare R2 bucket for shift report photos (required for photo uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shifttracker-photos
